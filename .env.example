# App URLs
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# NextAuth
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=replace-with-a-random-secret

# Google OAuth
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Callback URLs:
# - http://localhost:3000/api/auth/callback/google
# - https://itos.nu/api/auth/callback/google
# Optional. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# GitHub OAuth
# GitHub -> Settings -> Developer settings -> OAuth Apps
# Callback URLs:
# - http://localhost:3000/api/auth/callback/github
# - https://itos.nu/api/auth/callback/github
# Optional. Leave empty to disable GitHub sign-in.
GITHUB_ID=replace-with-github-client-id
GITHUB_SECRET=replace-with-github-client-secret

# Stripe
# Stripe Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace-with-stripe-publishable-key

# Optional site metadata
SITE_NAME=ITOS
AUTHOR_NAME=ITOS